
use("dating_app");

// Es sollen alle Datensätze in der DB ausgegeben werden.
use("dating_app");
db.getCollection("person").find();

// Es soll der Datensatz über Werner ausgegeben werden.
use("dating_app");
db.getCollection("person").findOne({name: "Werner"});

// Es sollen alle Personen ausgegeben werden, die schon länger als 2 Jahren Single sind.
use("dating_app");
db.getCollection("person").find({single_since: {$gt: 2}});

// Es sollen die Hobbies von Werner ausgegeben werden.
use("dating_app");
db.getCollection("person").aggregate(
    [
        {$match: {name: "Werner"}},
        {$unwind: "$hobbies"},
        {$group: {_id: "$hobbies"}}
    ]
);

// Es soll die Anzahl der Hobbies von Werner ausgegeben werden.
use("dating_app");
db.getCollection("person").aggregate(
    [
        {$match: {name: "Werner"}}, // kann auch entfernt werden
        {$unwind: "$hobbies"},
        {
            $group: {
                _id: "$name",
                anzahl_hobbies: {$sum: 1}
            }
        }
    ]
);

// Es sollen alle Datensätze ausgegeben werden, in denen das Attribut Geburtsdatum gesetzt wurde.
use("dating_app");
db.getCollection("person").find({birthdate: {$exists: true}});
db.getCollection("person").find({birthdate: {$exists: 1}});

// Es soll das Durchschnittsalter aller Personen ermittelt werden.
use("dating_app");
db.getCollection("person").aggregate(
    [
        {$group: {
            _id: "Alle Personen",
            avg_age: {$avg: "$age"}
        }}
    ]
);

// Es soll die Anzahl der Nennungen jedes Hobbies ermittelt werden.
use("dating_app");
db.getCollection("person").aggregate(
    [
        {$unwind: "$hobbies"},
        {$group: {
            _id: "$hobbies",
            anzahl: {$sum: 1}
        }},
        {$project: {
            _id: "$_id",
            more_than_2: {$gt: ["$anzahl", 2]}
        }},
        {$match: {more_than_2: true}},
        {$project: {
            _id: "$_id"
        }}
    ]
);

// Es soll Maximale Anzahl an Berufsverhältnissen ermittelt werden.
use("dating_app");
db.getCollection("person").aggregate(
    [
        {$unwind: "$jobs"},
        {$group: {
            _id: "$jobs.job",
            anzahl: {$sum: 1}
        }},
        {$group: {
            _id: "Maximal Anzahl an Jobs",
            anzahl: {$max: "$anzahl"}
        }}
    ]
);

use("dating_app");
db.getCollection("person").aggregate(
    [
        {$unwind: "$jobs"},
        {$group: {
            _id: "$jobs.job",
            anzahl: {$sum: 1}
        }},
        {$sort: {"anzahl": -1}},
        {$limit: 1}
    ]
);


